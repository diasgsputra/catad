# ── Database ──
POSTGRES_USER=catad
POSTGRES_PASSWORD=catad_rahasia
POSTGRES_DB=catad

# Dipakai Prisma. Di dalam Docker host-nya "db", di luar Docker "localhost:1062".
DATABASE_URL=postgresql://catad:catad_rahasia@localhost:1062/catad?schema=public

# ── Aplikasi ──
# Minimal 32 karakter. WAJIB diganti di produksi.
JWT_SECRET=ubah-rahasia-ini-di-produksi-minimal-32-karakter
APP_URL=http://localhost:1061

# Set true hanya bila aplikasi diakses lewat HTTPS.
COOKIE_SECURE=false

# Isi data demo saat migrasi pertama.
SEED_DEMO=true
