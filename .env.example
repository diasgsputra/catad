# ── Database ──
POSTGRES_USER=catad
POSTGRES_PASSWORD=catad_rahasia
POSTGRES_DB=catad

# Dipakai Prisma dari host (di luar Docker). Di dalam Docker, host-nya "db"
# dan URL-nya dirakit otomatis oleh docker-compose.yml.
DATABASE_URL=postgresql://catad:catad_rahasia@localhost:1062/catad?schema=public

# ── Port ──
# Rentang yang dialokasikan untuk Catad: 1061-1070.
PORT_APP=1061
PORT_DB=1062

# ── Aplikasi ──
# Minimal 32 karakter. WAJIB diganti di produksi.
JWT_SECRET=ubah-rahasia-ini-di-produksi-minimal-32-karakter
APP_URL=http://localhost:1061

# Set true hanya bila aplikasi diakses lewat HTTPS.
COOKIE_SECURE=false

# Isi data demo saat migrasi pertama. Di server sebaiknya false, karena akun
# demo memakai kata sandi yang tertulis di README.
SEED_DEMO=true
